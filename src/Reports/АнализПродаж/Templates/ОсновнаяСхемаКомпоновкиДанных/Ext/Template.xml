		<field xsi:type="DataSetFieldField">
			<dataPath>Категория</dataPath>
			<field>Категория</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Категория</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ПродажиОбороты.Клиент КАК Клиент,
	ПродажиОбороты.Услуга КАК Услуга,
	ПродажиОбороты.ВидАбонемента КАК ВидАбонемента,
	ПродажиОбороты.КоличествоОборот КАК КоличествоОборот,
	ПродажиОбороты.СуммаОборот КАК СуммаОборот,
	ВЫБОР
		КОГДА ПродажиОбороты.ВидАбонемента = ЗНАЧЕНИЕ(Справочник.ВидыАбонементов.ПустаяСсылка)
			ТОГДА "Разовые услуги"
		ИНАЧЕ "Абонементы"
	КОНЕЦ КАК Категория
ИЗ
	РегистрНакопления.Продажи.Обороты КАК ПродажиОбороты</query>
	</dataSet>
	<calculatedField>
		<dataPath>Позиция</dataPath>
		<expression>ВЫБОР КОГДА ВидАбонемента = ЗНАЧЕНИЕ(Справочник.ВидыАбонементов.ПустаяСсылка)
ТОГДА ПРЕДСТАВЛЕНИЕ(Услуга)
ИНАЧЕ ПРЕДСТАВЛЕНИЕ(ВидАбонемента)
КОНЕЦ</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Позиция</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>СерияГрафика</dataPath>
		<expression>ВЫБОР КОГДА &amp;РазрезДанных = "Категория" ТОГДА Категория
КОГДА &amp;РазрезДанных = "Клиент" ТОГДА ПРЕДСТАВЛЕНИЕ(Клиент)
КОГДА &amp;РазрезДанных = "Услуга" ТОГДА ПРЕДСТАВЛЕНИЕ(Услуга)
КОГДА &amp;РазрезДанных = "ВидАбонемента" ТОГДА ПРЕДСТАВЛЕНИЕ(ВидАбонемента)
ИНАЧЕ "Неизвестный разрез"
КОНЕЦ</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Серия графика</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>РесурсОтчета</dataPath>
		<expression>ВЫБОР КОГДА
&amp;Показатель = "Сумма" ТОГДА СуммаОборот
КОГДА &amp;Показатель = "Количество" ТОГДА КоличествоОборот
ИНАЧЕ 0
КОНЕЦ</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Ресурс отчета</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>ОтборПоРазрезу</dataPath>
		<expression>ВЫБОР КОГДА &amp;РазрезДанных = "ВидАбонемента" ТОГДА ВидАбонемента &lt;&gt; ЗНАЧЕНИЕ(Справочник.ВидыАбонементов.ПустаяСсылка)
КОГДА &amp;РазрезДанных = "Услуга" ТОГДА Услуга &lt;&gt; ЗНАЧЕНИЕ(Справочник.Услуги.ПустаяСсылка)
ИНАЧЕ ИСТИНА
КОНЕЦ</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Отбор по разрезу</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<totalField>
		<dataPath>КоличествоОборот</dataPath>
		<expression>Сумма(КоличествоОборот)</expression>
	</totalField>
