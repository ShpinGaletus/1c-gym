		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаОказания</dataPath>
			<field>ДатаОказания</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Тренер</dataPath>
			<field>Тренер</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Ссылка</dataPath>
			<field>Ссылка</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ОказаниеУслуги.Тренер КАК Тренер,
	ОказаниеУслуги.Ссылка КАК Ссылка,
	ОказаниеУслуги.ДатаОказания КАК ДатаОказания
ИЗ
	Документ.ОказаниеУслуги КАК ОказаниеУслуги
ГДЕ
	ОказаниеУслуги.ДатаОказания МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода</query>
	</dataSet>
	<calculatedField>
		<dataPath>ПериодГруппировки</dataPath>
		<expression>ВЫБОР КОГДА РАЗНОСТЬДАТ(&amp;Период.ДатаНачала, &amp;Период.ДатаОкончания, "ДЕНЬ") &gt; 365 ТОГДА НАЧАЛОПЕРИОДА(ДатаОказания, "ГОД")
КОГДА РАЗНОСТЬДАТ(&amp;Период.ДатаНачала, &amp;Период.ДатаОкончания, "ДЕНЬ") &gt; 31 ТОГДА НАЧАЛОПЕРИОДА(ДатаОказания, "МЕСЯЦ")
ИНАЧЕ НАЧАЛОПЕРИОДА(ДатаОказания, "ДЕНЬ")
КОНЕЦ</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период группировки</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<totalField>
		<dataPath>Ссылка</dataPath>
		<expression>Количество(Ссылка)</expression>
	</totalField>
